{
  "name": "chatgpt-controller-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build && node scripts/build-search.mjs",
    "build:pages": "SITE_BASE_PATH=/chatgpt-controller-desktop bun run build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "node scripts/lint.mjs",
    "format": "../node_modules/.bin/prettier --plugin ../node_modules/prettier-plugin-svelte --write 'src/**/*.{svelte,ts,css}' '*.js' 'scripts/*.mjs'",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "marked": "17.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.6.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
