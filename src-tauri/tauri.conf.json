{
 "$schema":"https://schema.tauri.app/config/2",
 "productName":"ChatGPT Controller",
 "identifier":"dev.aung.chatgptcontroller",
 "version":"0.1.0",
 "build":{
   "beforeDevCommand":"bun run dev",
   "devUrl":"http://127.0.0.1:1431",
   "beforeBuildCommand":"bun run build:all",
   "frontendDist":"../build"
 },
 "app":{
   "windows":[{"title":"ChatGPT Controller","width":1220,"height":795,"minWidth":900,"minHeight":640,"titleBarStyle":"Overlay","hiddenTitle":true,"backgroundColor":"#F6F7F5"}],
   "security":{"csp":null}
 },
 "bundle":{
   "active":true,
   "targets":["app"],
   "category":"DeveloperTool",
   "shortDescription":"Local ChatGPT browser API controller",
   "resources":["bin/controller"],
   "icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"]
 }
}
